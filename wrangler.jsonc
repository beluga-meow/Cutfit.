{
  // Cutfit AI API Worker.
  // Static files (index.html, js/, assets/) are served by GitHub Pages, so the
  // Worker only handles /api/*. Change this if you move the site to Pages.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cutfit-ai-api",
  "main": "index.js",
  "compatibility_date": "2026-11-21",
  "observability": {
    // Workers Logs: client errors and analytics events are written with
    // console.log, so they show up here without a third-party SDK.
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://beluga-meow.github.io",
    "DAILY_CAP": "150",
    "RESULT_TTL_SECONDS": "900"
  },
  "kv_namespaces": [
    {
      "binding": "CREDITS",
      "id": "3c6969729d5a40a6889fea0738b73922"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RESULTS",
      "bucket_name": "cutfit-results"
    }
  ],
  "triggers": {
    // Deletes expired previews from R2 every 15 minutes.
    "crons": ["*/15 * * * *"]
  },
  "placement": {
    "mode": "smart"
  }
}

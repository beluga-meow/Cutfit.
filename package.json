{
  "name": "cutfit",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Cutfit — face-shape haircut recommendations, AI previews and a 3D head simulator.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 -m http.server 3000",
    "worker:dev": "npx wrangler dev --local",
    "worker:deploy": "npx wrangler deploy",
    "check:mask": "node scripts/check-mask-data-url.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
